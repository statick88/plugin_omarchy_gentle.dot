#!/bin/sh
# Usage: /bin/sh bin/gentle-dot [native app arguments, e.g. --toggle]
# Desktop HOME/XDG for the native app/browser; project data/private Engram.
# No inherited auth variables. NOT a sandbox: desktop/Secret Service is accessible.
set -eu
umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
INSTALL="$ROOT/.gentle-dot-install"
APP="$ROOT/vendor/gentle-dot/apps/desktop/src-tauri/target/release/gentle-dot"
if [ ! -x "$APP" ]; then
    printf '%s\n' 'Gentle Dot native artifact missing. Run scripts/build-native.sh (see its review step).' >&2
    exit 127
fi
RUNTIME_PATH="$INSTALL/npm/bin:$INSTALL/cargo/bin:/usr/bin:/bin"
if [ -f "$INSTALL/runtime-path" ]; then
    IFS= read -r RUNTIME_PATH < "$INSTALL/runtime-path"
fi
# Without a desktop HOME, use the existing project fallback; do not query accounts.
DESKTOP_HOME="${HOME:-$INSTALL/home}"
mkdir -p "$INSTALL/data" "$INSTALL/tmp"
if [ -z "${HOME:-}" ]; then
    mkdir -p "$DESKTOP_HOME"
fi
cd "$INSTALL"
# Allowlist desktop resolution/transport, never caller credentials or agent overrides.
# Upstream isolatedAgentEnv owns engine HOME/XDG isolation under data/home.
# A dedicated memory port avoids the default Engram server; not a port sandbox.
exec /usr/bin/env -i PATH="$RUNTIME_PATH" HOME="$DESKTOP_HOME" \
    GENTLE_DOT_DATA_DIR="$INSTALL/data" GENTLE_DOT_ENGRAM=private GENTLE_DOT_ENGRAM_PORT=17438 \
    XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$DESKTOP_HOME/.config}" \
    XDG_DATA_HOME="${XDG_DATA_HOME:-$DESKTOP_HOME/.local/share}" \
    XDG_CACHE_HOME="${XDG_CACHE_HOME:-$DESKTOP_HOME/.cache}" \
    XDG_STATE_HOME="${XDG_STATE_HOME:-$DESKTOP_HOME/.local/state}" TMPDIR="$INSTALL/tmp" \
    BROWSER="${BROWSER:-}" XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-}" \
    XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-}" \
    DISPLAY="${DISPLAY:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
    "$APP" "$@"
